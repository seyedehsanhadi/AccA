<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:tools="http://schemas.android.com/tools"
        android:id="@+id/sex_item_rl"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:foreground="?attr/selectableItemBackground"
        android:padding="8dp">

    <CheckBox
            android:id="@+id/sex_item_checkbox"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            android:clickable="false" />

    <TextView
            android:id="@+id/sex_item_name_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_alignParentLeft="true"
            android:layout_toStartOf="@id/sex_item_checkbox"
            android:layout_toLeftOf="@id/sex_item_checkbox"
            android:ellipsize="end"
            android:maxLines="1"
            tools:text="Charge to 90%" />

    <!-- Command preview: two scripts can share a name, so the name alone is not always
         enough to tell them apart when picking what to export or import. -->
    <TextView
            android:id="@+id/sex_item_preview_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/sex_item_name_tv"
            android:layout_alignParentStart="true"
            android:layout_alignParentLeft="true"
            android:layout_toStartOf="@id/sex_item_checkbox"
            android:layout_toLeftOf="@id/sex_item_checkbox"
            android:alpha="0.7"
            android:ellipsize="end"
            android:maxLines="1"
            android:textSize="12sp"
            tools:text="acca -s pause_capacity=90" />
</RelativeLayout>
