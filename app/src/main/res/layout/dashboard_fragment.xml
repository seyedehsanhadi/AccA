<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    app:layout_behavior="@string/appbar_scrolling_view_behavior"
    tools:context=".activities.MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- ACCd Status Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/status_card_view"
            style="@style/Widget.MaterialComponents.CardView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/card_margin"
            android:layout_marginBottom="@dimen/card_margindiv2"
            android:layout_marginTop="@dimen/card_margin"
            android:layout_marginRight="@dimen/card_margin"
            app:cardCornerRadius="@dimen/card_corner_radius"
            app:cardElevation="3dp"
            app:contentPadding="@dimen/card_content_padding">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/dash_title_accdStatus_textView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/title_acc"
                    android:textAppearance="@style/TextAppearance.MaterialComponents.Headline5" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <RelativeLayout
                        android:id="@+id/dash_accdStatus_frameLay"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@color/color_warning">

                        <ImageView
                            android:id="@+id/dash_accdStatus_imageView"
                            android:layout_width="@dimen/acc_status_icon"
                            android:layout_height="@dimen/acc_status_icon"
                            app:tint="@color/white" />

                        <ProgressBar
                            android:id="@+id/dash_accdStatus_pb"
                            android:layout_width="@dimen/acc_status_icon"
                            android:layout_height="@dimen/acc_status_icon"
                            android:indeterminate="true" />

                    </RelativeLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingLeft="@dimen/card_content_padding">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/dash_daemonToggle_button"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton.Icon"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:enabled="false"
                            android:text="@string/start"
                            app:icon="@drawable/ic_outline_play_arrow_24px" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/dash_daemonRestart_button"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton.Icon"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:enabled="false"
                            android:text="@string/restart"
                            app:icon="@drawable/ic_sync_24px" />

                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/dash_accdStatus_textView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textStyle="bold"
                    android:padding="10dp"
                    android:text="@string/acc_daemon_status_reading_status"
                    android:gravity="center"/>
            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Charging-health warning card (B12): hidden unless charging looks broken -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/dash_health_warning_card"
            style="@style/Widget.MaterialComponents.CardView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/card_margin"
            android:layout_marginTop="@dimen/card_margindiv2"
            android:layout_marginRight="@dimen/card_margin"
            android:layout_marginBottom="@dimen/card_margindiv2"
            android:visibility="gone"
            app:cardBackgroundColor="@color/color_warning"
            app:cardCornerRadius="@dimen/card_corner_radius"
            app:cardElevation="3dp"
            app:contentPadding="@dimen/card_content_padding"
            tools:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="@dimen/acc_status_icon"
                    android:layout_height="@dimen/acc_status_icon"
                    android:layout_marginEnd="@dimen/card_content_padding"
                    android:layout_marginRight="@dimen/card_content_padding"
                    android:contentDescription="@string/info"
                    app:srcCompat="@drawable/ic_outline_error_outline_24px"
                    app:tint="@color/white" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/health_warning_title"
                        android:textColor="@color/white"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/health_warning_message"
                        android:textColor="@color/white"
                        android:textSize="14sp" />

                </LinearLayout>
            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Find my charging switch, moved up here from the bottom of the battery card so it sits
             between the daemon controls and the configuration. It used to live inside the config
             editor three navigations deep, and users reported not being able to find it at all. -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/switch_card_view"
            style="@style/Widget.MaterialComponents.CardView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/card_margin"
            android:layout_marginRight="@dimen/card_margin"
            android:layout_marginBottom="@dimen/card_margindiv2">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/dash_findSwitch_button"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/find_switch_title"
                app:icon="@drawable/ic_baseline_search_24"
                app:iconGravity="textStart" />
        </com.google.android.material.card.MaterialCardView>

        <RelativeLayout
            android:id="@+id/current_profile"
            android:layout_height="wrap_content"
            android:layout_width="match_parent" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.MaterialComponents.CardView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/card_margin"
            android:layout_marginBottom="@dimen/card_margin"
            android:layout_marginTop="@dimen/card_margindiv2"
            android:layout_marginRight="@dimen/card_margin"
            android:foreground="?selectableItemBackground"
            app:cardCornerRadius="@dimen/card_corner_radius"
            app:cardElevation="3dp"
            app:contentPadding="@dimen/card_content_padding">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Title: Battery -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/title_battery"
                    android:textAppearance="@style/TextAppearance.MaterialComponents.Headline5" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <com.dinuscxj.progressbar.CircleProgressBar
                        android:id="@+id/dash_batteryCapacity_pBar"
                        android:layout_width="70dp"
                        android:layout_height="70dp"
                        android:layout_gravity="center"
                        android:progress="0"
                        app:progress_end_color="@color/color_primary"
                        app:progress_shader="sweep"
                        app:progress_start_color="@color/color_secondary"
                        app:progress_stroke_cap="round"
                        app:progress_stroke_width="5dp"
                        app:progress_text_color="?android:attr/textColorPrimary"
                        app:progress_text_size="@dimen/label_text"
                        app:progress_style="solid_line" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="@dimen/card_content_padding"
                        android:orientation="vertical">

                        <!-- Battery Charging Status -->
                        <LinearLayout
                            android:orientation="horizontal"
                            android:layout_height="wrap_content"
                             android:layout_width="match_parent">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:ellipsize="end"
                                android:text="@string/info_status"
                                android:textSize="@dimen/label_text"
                                android:layout_weight="1"/>

                            <TextView
                                android:id="@+id/dash_batteryStatus_textView"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:gravity="end"
                                android:text="..." />
                        </LinearLayout>

                        <!-- Battery Charging Speed -->
                        <LinearLayout
                            android:orientation="horizontal"
                            android:layout_height="wrap_content"
                            android:layout_width="match_parent">

                            <TextView
                                android:id="@+id/dash_batteryChargingSpeed_textView"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:ellipsize="end"
                                android:text="@string/info_charging_speed"
                                android:textSize="@dimen/label_text"
                                android:layout_weight="1"/>

                            <TextView
                                android:id="@+id/dash_chargingSpeed_textView"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:gravity="end"
                                android:text="..." />
                        </LinearLayout>

                        <!-- Battery Temperature -->
                        <LinearLayout
                            android:orientation="horizontal"
                            android:layout_height="wrap_content"
                            android:layout_width="match_parent">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:ellipsize="end"
                                android:text="@string/info_temperature"
                                android:textSize="@dimen/label_text"
                                android:layout_weight="1"/>

                            <TextView
                                android:id="@+id/dash_batteryTemperature_textView"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:gravity="end"
                                android:text="..." />
                        </LinearLayout>

                        <!-- Battery Voltage -->
                        <LinearLayout
                            android:orientation="horizontal"
                            android:layout_height="wrap_content"
                            android:layout_width="match_parent">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:ellipsize="end"
                                android:text="@string/info_voltage"
                                android:textSize="@dimen/label_text"
                                android:layout_weight="1"/>

                            <TextView
                                android:id="@+id/dash_batteryVoltage_textView"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:gravity="end"
                                android:text="..." />
                        </LinearLayout>

                        <!-- Battery Health -->
                        <LinearLayout
                            android:orientation="horizontal"
                            android:layout_height="wrap_content"
                            android:layout_width="match_parent">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:ellipsize="end"
                                android:text="@string/info_health"
                                android:textSize="@dimen/label_text"
                                android:layout_weight="1"/>

                            <TextView
                                android:id="@+id/dash_batteryHealth_textView"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:gravity="end"
                                android:text="..." />
                        </LinearLayout>

                        <!-- Charger tier + input (rc11): a single full-width line (NOT a label:value
                             row) - the value is a long sentence and a weighted label:value row
                             squeezed the label to zero and overflowed the narrow text column (over
                             the capacity circle, and off the right edge). maxLines=2 + ellipsize
                             keeps it tidy. Shown only while charging with input telemetry. -->
                        <TextView
                            android:id="@+id/dash_charger_textView"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:ellipsize="end"
                            android:maxLines="2"
                            android:textColor="?android:attr/textColorSecondary"
                            android:textSize="@dimen/label_text"
                            android:visibility="gone" />

                        <!-- Manual-lock badge: shown only when the daemon state report sets userLocked -->
                        <TextView
                            android:id="@+id/dash_manualLock_textView"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:gravity="center_vertical"
                            android:text="@string/manual_lock_protected"
                            android:textColor="@color/colorSuccessful"
                            android:textSize="@dimen/label_text"
                            android:textStyle="bold"
                            android:visibility="gone" />

                    </LinearLayout>
                </LinearLayout>

                <!-- Buttons -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:orientation="vertical">

                    <!-- Find my charging switch has moved OUT of this card, up to its own card
                         directly under the daemon controls. See the switch_card_view below the
                         status card. It sits above the configuration because choosing a working
                         switch is a precondition for the configuration meaning anything. -->

                    <!-- These two share a row rather than taking one each. Neither is
                         removed: "charge once" is a real one-off override and resetting the
                         gauge is occasionally the right answer after a deep discharge. They
                         are just not what someone opens the app to do. -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/dash_editCargingLimitOnce_button"
                            style="@style/Widget.MaterialComponents.Button.TextButton"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:insetLeft="0dp"
                            android:insetRight="0dp"
                            android:paddingLeft="4dp"
                            android:paddingRight="4dp"
                            android:textSize="12sp"
                            android:text="@string/edit_charging_limit_once_button" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/dash_resetBatteryStats_button"
                            style="@style/Widget.MaterialComponents.Button.TextButton"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:insetLeft="0dp"
                            android:insetRight="0dp"
                            android:paddingLeft="4dp"
                            android:paddingRight="4dp"
                            android:textSize="12sp"
                            android:text="@string/reset_stats" />
                    </LinearLayout>
                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>